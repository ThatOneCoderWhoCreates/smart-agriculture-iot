{
  "version": 1,
  "author": "Smart Agriculture Field Node",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-devkit-c-v4", "id": "esp", "top": 0, "left": 0, "attrs": {} },

    { "type": "wokwi-dht22", "id": "dht", "top": -120, "left": 250, "attrs": {} },

    { "type": "wokwi-potentiometer", "id": "soil", "top": 30, "left": -230,
      "attrs": { "value": "620" } },

    { "type": "wokwi-photoresistor-sensor", "id": "ldr", "top": -110, "left": -240,
      "attrs": {} },

    { "type": "wokwi-hc-sr04", "id": "ultra", "top": 130, "left": 240, "attrs": {} },

    { "type": "wokwi-relay-module", "id": "relay", "top": 250, "left": -40,
      "attrs": {} },

    { "type": "wokwi-buzzer", "id": "buzz", "top": 250, "left": 200,
      "attrs": { "volume": "0.1" } },

    { "type": "wokwi-led", "id": "ledG", "top": -190, "left": 60,
      "attrs": { "color": "green", "label": "OK" } },
    { "type": "wokwi-led", "id": "ledY", "top": -190, "left": 110,
      "attrs": { "color": "yellow", "label": "PUMP" } },
    { "type": "wokwi-led", "id": "ledR", "top": -190, "left": 160,
      "attrs": { "color": "red", "label": "ALERT" } },

    { "type": "wokwi-resistor", "id": "rG", "top": -140, "left": 55,
      "attrs": { "value": "220" } },
    { "type": "wokwi-resistor", "id": "rY", "top": -140, "left": 105,
      "attrs": { "value": "220" } },
    { "type": "wokwi-resistor", "id": "rR", "top": -140, "left": 155,
      "attrs": { "value": "220" } },

    { "type": "wokwi-lcd1602", "id": "lcd", "top": 380, "left": 180,
      "attrs": { "pins": "i2c", "background": "green" } }
  ],

  "connections": [
    [ "esp:TX0", "$serialMonitor:RX", "", [] ],
    [ "esp:RX0", "$serialMonitor:TX", "", [] ],

    [ "dht:VCC", "esp:3V3", "red", [ "v0" ] ],
    [ "dht:GND", "esp:GND.1", "black", [ "v0" ] ],
    [ "dht:SDA", "esp:D4", "green", [ "v0" ] ],

    [ "soil:VCC", "esp:3V3", "red", [ "v0" ] ],
    [ "soil:GND", "esp:GND.2", "black", [ "v0" ] ],
    [ "soil:SIG", "esp:D34", "orange", [ "v0" ] ],

    [ "ldr:VCC", "esp:3V3", "red", [ "v0" ] ],
    [ "ldr:GND", "esp:GND.2", "black", [ "v0" ] ],
    [ "ldr:AO", "esp:D35", "gold", [ "v0" ] ],

    [ "ultra:VCC", "esp:VIN", "red", [ "v0" ] ],
    [ "ultra:GND", "esp:GND.3", "black", [ "v0" ] ],
    [ "ultra:TRIG", "esp:D12", "blue", [ "v0" ] ],
    [ "ultra:ECHO", "esp:D14", "purple", [ "v0" ] ],

    [ "relay:VCC", "esp:VIN", "red", [ "v0" ] ],
    [ "relay:GND", "esp:GND.3", "black", [ "v0" ] ],
    [ "relay:IN", "esp:D26", "cyan", [ "v0" ] ],

    [ "buzz:2", "esp:D25", "magenta", [ "v0" ] ],
    [ "buzz:1", "esp:GND.3", "black", [ "v0" ] ],

    [ "esp:D27", "rG:1", "green", [ "v0" ] ],
    [ "rG:2", "ledG:A", "green", [ "v0" ] ],
    [ "ledG:C", "esp:GND.1", "black", [ "v0" ] ],

    [ "esp:D33", "rY:1", "gold", [ "v0" ] ],
    [ "rY:2", "ledY:A", "gold", [ "v0" ] ],
    [ "ledY:C", "esp:GND.1", "black", [ "v0" ] ],

    [ "esp:D32", "rR:1", "red", [ "v0" ] ],
    [ "rR:2", "ledR:A", "red", [ "v0" ] ],
    [ "ledR:C", "esp:GND.1", "black", [ "v0" ] ],

    [ "lcd:VCC", "esp:VIN", "red", [ "v0" ] ],
    [ "lcd:GND", "esp:GND.2", "black", [ "v0" ] ],
    [ "lcd:SDA", "esp:D21", "green", [ "v0" ] ],
    [ "lcd:SCL", "esp:D22", "blue", [ "v0" ] ]
  ],

  "dependencies": {}
}
